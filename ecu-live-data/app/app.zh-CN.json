{
  "id": "boostline_cn",
  "title": "ECU 实时数据",
  "description": "只读查看发动机实时数据，支持 CSV 记录、道路测功与加速计时。",
  "version": "1.0.101",
  "vendor": "boostline",
  "loggingId": "OAB1",
  "iconGlyph": "ECU",
  "maxDiskUsage": 134217728,
  "signals": {
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car's state: no requests to the DDE/DME while it's switched off",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "_optional": "the engine oil temperature and engine speed the car shows (Oil temp (car bus), the dyno)",
      "statusEngineTemperature": "rs",
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "the car's speed (the dyno)",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "the DSC's longitudinal acceleration (the dyno)",
      "statusLongitudinalAccelerationMassCenter": "rs"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "the gearbox oil temperature the car sends (Engine page), as M Vitals",
      "basicDataSet": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "torque and power as the car's bus and sport displays give them (Power page)",
      "statusActualValueTorque2": "rs",
      "statusVehicleDynamicEngine": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
