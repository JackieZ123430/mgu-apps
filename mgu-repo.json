{
  "schema": 1,
  "components": [
    {
      "id": "boostline_cn",
      "kind": "app",
      "path": "ecu-live-data/app",
      "manifest": "app.zh-CN.json",
      "title": "ECU 实时数据",
      "description": "只读查看发动机实时数据，支持 CSV 记录、道路测功与加速计时。",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0",
        "mgu-deploy": "0.8.19"
      },
      "icon": "icon.png",
      "build": {
        "python": "localization/build_zh_cn.py",
        "args": [
          "{id}"
        ],
        "sdk": "vendor/idrive7-apps/oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "shared": [
          "vendor/idrive7-apps/kit",
          "vendor/idrive7-apps/apps",
          "localization"
        ]
      }
    },
    {
